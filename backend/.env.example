NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/ledger_db

# JWT Configuration
# Access token: 15 minutes, Refresh token: 7 days
JWT_ACCESS_SECRET=ledger_super_secret_access_jwt_key_2026_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=ledger_super_secret_refresh_jwt_key_2026_change_in_production
JWT_REFRESH_EXPIRES_IN=7d

# SMTP / Email Configuration for OTP and notifications
# For development, if SMTP is not provided or fails, OTP is logged to console
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=ledger_test_user
SMTP_PASS=ledger_test_pass
SMTP_FROM="LEDGER App <no-reply@ledger.app>"

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000
